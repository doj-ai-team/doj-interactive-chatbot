    "6216705d-de56-48ed-a1a7-e52b315101ac": "{\"id\": \"6216705d-de56-48ed-a1a7-e52b315101ac\", \"title\": \"New Chat\", \"created_at\": \"2026-03-09T16:03:48.173456\", \"updated_at\": \"2026-03-09T16:03:48.174601\", \"user_id\": 4, \"generated\": [], \"past\": [], \"source\": []}",
